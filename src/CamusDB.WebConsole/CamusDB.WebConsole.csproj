<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>0.11.1</Version>
    <Description>CamusDB.WebConsole allows database management from a Web UI.</Description>
    <Authors>CamusDB</Authors>
    <Company>CamusDB</Company>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMonaco" Version="3.5.0" />
    <PackageReference Include="CamusDB.Client" Version="0.10.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="MudBlazor" Version="9.*" />
  </ItemGroup>
</Project>
