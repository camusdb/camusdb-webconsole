@inject CamusSessionService Session
@inject ISnackbar Snackbar
@inject ConsolePreferencesService Prefs

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Configure connection</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            @* A locked endpoint is not rendered at all, rather than rendered disabled. Disabled still
               shows it, and a visitor who cannot change the address has no use for it — while on a
               console reachable from the internet it describes the operator's internal network. The
               value still travels to Connect through _endpoint, which the dialog read from the
               session. *@
            @if (!Session.EndpointLocked)
            {
                <MudTextField @bind-Value="_endpoint"
                              Label="Endpoint"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              HelperText="e.g. http://localhost:5095 (REST) or http://localhost:5096 (gRPC)" />
            }
            <MudTextField @bind-Value="_database"
                          Label="Database"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            @if (!Session.EndpointLocked)
            {
                <MudSelect T="string" @bind-Value="_protocol" Label="Protocol" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("rest")">REST</MudSelectItem>
                    <MudSelectItem Value="@("grpc")">gRPC</MudSelectItem>
                </MudSelect>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    The server and the protocol are fixed by this console's configuration.
                </MudText>
            }

            <MudDivider Class="mt-1" />
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">
                Authentication
            </MudText>
            @if (Session.RequiresAccessToken)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    This console accepts an access token only (CamusDB:RequireAccessToken), so user and
                    password sign-in is disabled. Leave the field empty against a server with
                    authentication disabled.
                </MudText>
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Leave empty against a server with authentication disabled — the default for a fresh
                    CamusDB install. The password is exchanged once for a short-lived token and is never
                    stored in the browser.
                </MudText>
            }

            @* One panel is not a choice, so the tab strip is dropped rather than shown with a single
               tab. The field itself is defined once, in AccessTokenField, so the two branches cannot
               drift apart. *@
            @if (Session.RequiresAccessToken)
            {
                <MudStack Spacing="3" Class="mt-3">
                    @AccessTokenField
                </MudStack>
            }
            else
            {
                <MudTabs Elevation="0"
                         Rounded="true"
                         ActivePanelIndex="_authMode"
                         ActivePanelIndexChanged="OnAuthModeChanged">
                    <MudTabPanel Text="User / password">
                        <MudStack Spacing="3" Class="mt-3">
                            <MudTextField @bind-Value="_user"
                                          Label="User"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          autocomplete="username"
                                          HelperText="Empty connects without authentication." />
                            <MudTextField @bind-Value="_password"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          Immediate="true"
                                          autocomplete="current-password"
                                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="TogglePasswordVisibility"
                                          AdornmentAriaLabel="Show password" />
                        </MudStack>
                    </MudTabPanel>
                    <MudTabPanel Text="Access token">
                        <MudStack Spacing="3" Class="mt-3">
                            @AccessTokenField
                        </MudStack>
                    </MudTabPanel>
                </MudTabs>
            }

            @if (!Session.EndpointLocked)
            {
                <MudDivider Class="mt-1" />
                <MudTextField @bind-Value="_backupEndpoint"
                              Label="Backup endpoint (optional)"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              HelperText="Defaults to the endpoint above. Set it for a gRPC connection (the backup API is REST-only) or to pin a multi-node pool at the coordinator." />
            }
            <MudDivider Class="mt-1" />

            <MudNumericField @bind-Value="_timeoutSeconds"
                             Label="Timeout (seconds)"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="600" />
            <MudNumericField @bind-Value="_maxRows"
                             Label="Max result rows"
                             Variant="Variant.Outlined"
                             Min="1"
                             Max="100000" />
            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="ConnectAsync"
                   Disabled="_busy"
                   Class="run-btn">
            @(_busy ? "Connecting…" : "Connect")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int UserPasswordTab = 0;
    private const int AccessTokenTab = 1;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _endpoint = "";
    private string _database = "";
    private string _protocol = "rest";
    private string _user = "";
    private string _password = "";
    private string _accessToken = "";
    private string _backupEndpoint = "";
    private int _authMode = UserPasswordTab;
    private bool _showPassword;
    private int _timeoutSeconds = 30;
    private int _maxRows = 1000;
    private string? _error;
    private bool _busy;

    /// <summary>
    /// The access token field, defined once and rendered by both branches of the authentication
    /// section — with the tab strip when a choice exists, on its own when it does not.
    /// </summary>
    private RenderFragment AccessTokenField => @<MudTextField @bind-Value="_accessToken"
                                                              Label="Access token"
                                                              Variant="Variant.Outlined"
                                                              Immediate="true"
                                                              InputType="InputType.Password"
                                                              HelperText="A token obtained elsewhere, sent verbatim. The console cannot renew it, so the session ends when the server expires it." />;

    protected override async Task OnInitializedAsync()
    {
        _endpoint = Session.Endpoint;
        _database = Session.Database;
        _protocol = Session.Protocol;
        _timeoutSeconds = Session.TimeoutSeconds;
        _maxRows = Session.MaxRows;
        _backupEndpoint = Session.BackupEndpoint;
        _user = Session.User;
        _authMode = Session.UsesSuppliedToken || Session.RequiresAccessToken ? AccessTokenTab : UserPasswordTab;

        // The password is never persisted; the user name is, so a reconnect only needs the secret.
        // A console that refuses user/password sign-in has no field to prefill.
        if (string.IsNullOrEmpty(_user) && !Session.RequiresAccessToken)
        {
            try
            {
                await Prefs.EnsureLoadedAsync();
                _user = Prefs.Current.User ?? "";
            }
            catch
            {
                // Storage unavailable; start with an empty user.
            }
        }
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    /// <summary>The driver treats a token and a user/password pair as exclusive, so switching clears the other.</summary>
    private void OnAuthModeChanged(int index)
    {
        _authMode = index;

        if (index == AccessTokenTab)
            _password = "";
        else
            _accessToken = "";
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task ConnectAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            bool useToken = _authMode == AccessTokenTab;

            await Session.ConfigureAndConnectAsync(
                _endpoint,
                _database,
                _protocol,
                _timeoutSeconds,
                _maxRows,
                user: useToken ? null : _user,
                password: useToken ? null : _password,
                accessToken: useToken ? _accessToken : null,
                backupEndpoint: _backupEndpoint);

            await Prefs.SetDatabaseAsync(Session.Database);
            await Prefs.SetUserAsync(Session.User);

            string identity = Session.IsAuthenticated
                ? Session.UsesSuppliedToken ? " as a token holder" : $" as {Session.User}"
                : "";
            string where = Session.EndpointLocked ? Session.Database : $"{Session.Database} @ {Session.Endpoint}";
            Snackbar.Add($"Connected to {where}{identity}", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
