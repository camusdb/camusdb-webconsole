@inject CamusSessionService Session
@inject QueryExecutionService Queries
@inject ConsolePreferencesService Prefs
@inject QueryHistoryService History
@inject SchemaCompletionSource Completion
@inject SchemaChangeNotifier SchemaChanges
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@implements IDisposable

<div class="query-workspace">
    <div class="query-tabs">
        @foreach (QueryTab tab in _tabs)
        {
            <div class="query-tab @(tab.Id == _activeId ? "active" : null)"
                 @onclick="() => ActivateAsync(tab.Id)"
                 role="tab"
                 aria-selected="@(tab.Id == _activeId)">
                <span class="query-tab-title">@tab.Title</span>
                @if (_tabs.Count > 1)
                {
                    <button type="button"
                            class="query-tab-close"
                            title="Close tab"
                            @onclick="() => CloseTabAsync(tab.Id)"
                            @onclick:stopPropagation="true">
                        ×
                    </button>
                }
            </div>
        }
        <button type="button"
                class="query-tab-add"
                title="New query tab"
                @onclick="AddTabAsync">
            +
        </button>
    </div>

    <div class="query-split">
        <div class="query-editor-pane" style="@($"height:{_editorHeight}px")">
            <div class="query-editor-toolbar">
                <MudTooltip Text="Query history">
                    <MudIconButton Icon="@Icons.Material.Filled.History"
                                   Size="Size.Small"
                                   Class="history-btn"
                                   OnClick="OpenHistoryAsync"
                                   aria-label="Query history" />
                </MudTooltip>
                <span class="toolbar-spacer"></span>
                @if (_running)
                {
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Stop"
                               OnClick="CancelRun">
                        Stop
                    </MudButton>
                }
                <MudTooltip Text="Alt+X — every statement of the selection, or of the tab, in order">
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Small"
                               Class="run-script-btn"
                               StartIcon="@Icons.Material.Filled.PlaylistPlay"
                               Disabled="_running || !Session.IsConnected"
                               OnClick="RunScriptAsync">
                        Run script
                    </MudButton>
                </MudTooltip>
                <MudTooltip Text="Ctrl/Cmd+Enter — the selection, or the statement at the cursor">
                    <MudButton Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="run-btn"
                               StartIcon="@Icons.Material.Filled.PlayArrow"
                               Disabled="_running || !Session.IsConnected"
                               OnClick="RunAsync">
                        @(_hasSelection ? "Run selection" : "Run statement")
                    </MudButton>
                </MudTooltip>
            </div>
            @if (ActiveTab is not null)
            {
                <div style="flex:1; min-height:0;" @key="ActiveTab.Id">
                    <QueryEditor @ref="_editor"
                                 EditorId="@($"sql-editor-{ActiveTab.Id}")"
                                 Value="@ActiveTab.Sql"
                                 ValueChanged="OnSqlChangedAsync"
                                 HasSelectionChanged="OnHasSelectionChanged"
                                 OnRunRequested="RunAsync"
                                 OnRunScriptRequested="RunScriptAsync"
                                 CompletionSource="_completionRef" />
                </div>
            }
        </div>

        <div class="split-handle"
             @onpointerdown="OnSplitPointerDown"></div>

        @if (_splitting)
        {
            <div class="split-overlay"
                 @onpointermove="OnSplitPointerMove"
                 @onpointerup="OnSplitPointerUp"
                 @onpointercancel="OnSplitPointerUp"></div>
        }

        <div class="results-pane" @key="@($"results-{_activeId}")">
            @if (ActiveTab is { Results.Count: > 1 } scriptTab)
            {
                <div class="result-tabs" role="tablist" aria-label="Statement results">
                    @for (int r = 0; r < scriptTab.Results.Count; r++)
                    {
                        int index = r;
                        StatementRun run = scriptTab.Results[index];
                        <button type="button"
                                role="tab"
                                class="result-tab @(index == scriptTab.ActiveResult ? "active" : null) @(run.Result.Success ? null : "failed")"
                                aria-selected="@(index == scriptTab.ActiveResult ? "true" : "false")"
                                title="@run.Sql"
                                @onclick="() => scriptTab.ActiveResult = index">
                            <span class="result-tab-index">@(index + 1)</span>
                            <span class="result-tab-title">@TruncateTitle(run.Sql)</span>
                        </button>
                    }
                    @if (scriptTab.SkippedStatements > 0)
                    {
                        <span class="result-tabs-note">@scriptTab.SkippedStatements not run</span>
                    }
                </div>
            }
            <ExecutionStatusBar Result="ActiveTab?.LastResult" />
            <ResultsGrid Result="ActiveTab?.LastResult"
                         TableContext="ActiveTab?.DataContext"
                         Busy="_running"
                         ServerFilter="@ActiveTab?.DataWhere"
                         ServerOrderBy="@ActiveTab?.DataOrderBy"
                         ServerDescending="ActiveTab?.DataDescending ?? false"
                         OnServerFilter="ApplyDataFilterAsync"
                         OnServerSort="ApplyDataSortAsync"
                         OnFetchMore="FetchMoreAsync"
                         OnDataChanged="RefreshActiveDataAsync" />
        </div>
    </div>
</div>

@code {
    private readonly List<QueryTab> _tabs = [];
    private string _activeId = "";
    private QueryEditor? _editor;
    private bool _running;
    private CancellationTokenSource? _cts;
    private int _editorHeight = 220;
    private bool _splitting;
    private double _splitStartY;
    private int _splitStartHeight;
    private int _tabSeq = 1;
    private bool _hydrated;
    private bool _hasSelection;
    private DotNetObjectReference<SchemaCompletionSource>? _completionRef;

    private QueryTab? ActiveTab => _tabs.FirstOrDefault(t => t.Id == _activeId);

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        _completionRef = DotNetObjectReference.Create(Completion);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hydrated)
            return;

        _hydrated = true;

        try
        {
            await Prefs.EnsureLoadedAsync();
            ConsoleUiPreferences prefs = Prefs.Current;

            if (prefs.EditorHeight is int height)
                _editorHeight = Math.Clamp(height, 120, 700);

            if (prefs.Tabs is { Count: > 0 })
            {
                _tabs.Clear();
                foreach (PersistedQueryTab saved in prefs.Tabs)
                {
                    if (string.IsNullOrWhiteSpace(saved.Id))
                        continue;

                    _tabs.Add(new QueryTab
                    {
                        Id = saved.Id,
                        Title = string.IsNullOrWhiteSpace(saved.Title) ? "SQL" : saved.Title,
                        Sql = saved.Sql ?? "",
                    });
                }

                if (_tabs.Count > 0)
                {
                    _tabSeq = prefs.TabSeq > 0
                        ? prefs.TabSeq
                        : Math.Max(1, _tabs.Count + 1);

                    _activeId = _tabs.Any(t => t.Id == prefs.ActiveTabId)
                        ? prefs.ActiveTabId!
                        : _tabs[0].Id;
                }
            }
        }
        catch
        {
            // Fall back to a default tab below.
        }

        if (_tabs.Count == 0)
            AddTabCore(selectSql: "SELECT 1", persist: false);

        StateHasChanged();
    }

    public async Task InsertSqlAsync(string sql)
    {
        await PersistActiveEditorAsync();

        if (ActiveTab is null)
            AddTabCore(selectSql: sql);
        else
        {
            ActiveTab.Sql = sql;
            ActiveTab.Title = TruncateTitle(sql);
            ActiveTab.DataContext = null;
            ActiveTab.ClearResults();
            await PersistTabsAsync();
        }

        StateHasChanged();
    }

    public async Task OpenTableDataAsync(TableDataContext context)
    {
        await PersistActiveEditorAsync();

        // No LIMIT: the grid pages through the table, MaxRows rows at a time.
        string sql = SqlBuilder.BuildTableQuery(context.Table, where: null, orderBy: null, descending: false);

        if (ActiveTab is null)
            AddTabCore(selectSql: sql);

        if (ActiveTab is not null)
        {
            ActiveTab.Sql = sql;
            ActiveTab.Title = $"data:{context.Table}";
            ActiveTab.DataContext = context;
            ActiveTab.DataWhere = null;
            ActiveTab.DataOrderBy = null;
            ActiveTab.DataDescending = false;
            ActiveTab.ClearResults();
            await PersistTabsAsync();
        }

        StateHasChanged();

        // Programmatic: run the SELECT we just wrote, not a selection left over from the old content.
        _hasSelection = false;
        await RunCoreAsync(RunMode.Tab);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void OnHasSelectionChanged(bool hasSelection)
    {
        if (_hasSelection == hasSelection)
            return;

        _hasSelection = hasSelection;
        StateHasChanged();
    }

    private async Task OnSqlChangedAsync(string sql)
    {
        if (ActiveTab is null)
            return;

        ActiveTab.Sql = sql;
        await PersistTabsAsync(debounce: true);
    }

    private async Task AddTabAsync()
    {
        await PersistActiveEditorAsync();
        AddTabCore(selectSql: "");
    }

    private void AddTabCore(string selectSql, bool persist = true)
    {
        var tab = new QueryTab
        {
            Id = Guid.NewGuid().ToString("N"),
            Title = string.IsNullOrWhiteSpace(selectSql) ? $"SQL {_tabSeq}" : TruncateTitle(selectSql),
            Sql = selectSql,
        };
        _tabSeq++;
        _tabs.Add(tab);
        _activeId = tab.Id;
        _hasSelection = false;

        if (persist)
            _ = PersistTabsAsync();
    }

    private async Task ActivateAsync(string id)
    {
        if (id == _activeId)
            return;

        await PersistActiveEditorAsync();
        _activeId = id;
        // Each tab gets its own keyed editor, so the incoming one starts with nothing selected.
        _hasSelection = false;
        await PersistTabsAsync();
    }

    private async Task CloseTabAsync(string id)
    {
        if (_tabs.Count <= 1)
            return;

        if (id == _activeId)
            await PersistActiveEditorAsync();

        int index = _tabs.FindIndex(t => t.Id == id);
        if (index < 0)
            return;

        _tabs.RemoveAt(index);
        if (_activeId == id)
        {
            _activeId = _tabs[Math.Clamp(index, 0, _tabs.Count - 1)].Id;
            _hasSelection = false;
        }

        await PersistTabsAsync();
    }

    private async Task PersistActiveEditorAsync()
    {
        if (_editor is null || ActiveTab is null)
            return;

        try
        {
            await _editor.SyncValueAsync();
        }
        catch
        {
            // Editor may already be disposed while switching tabs.
        }
    }

    private Task PersistTabsAsync(bool debounce = false)
    {
        var snapshot = _tabs
            .Select(t => new PersistedQueryTab
            {
                Id = t.Id,
                Title = t.Title,
                Sql = t.Sql ?? "",
            })
            .ToList();

        return Prefs.SaveTabsAsync(snapshot, _activeId, _tabSeq, debounce);
    }

    /// <summary>What a run executes.</summary>
    private enum RunMode
    {
        /// <summary>The selection (each of its statements), or else the statement at the cursor.</summary>
        Statement,

        /// <summary>Each statement of the selection, or else of the whole tab.</summary>
        Script,

        /// <summary>
        /// The tab's own SQL, never the selection. For programmatic re-runs (a row edit refreshing its
        /// grid), which must not execute whatever the user happens to have highlighted.
        /// </summary>
        Tab,
    }

    private Task RunAsync() => RunCoreAsync(RunMode.Statement);

    private Task RunScriptAsync() => RunCoreAsync(RunMode.Script);

    private async Task RunCoreAsync(RunMode mode)
    {
        if (ActiveTab is null || _running)
            return;

        if (!Session.IsConnected)
        {
            Snackbar.Add("Not connected. Open Configure to connect.", Severity.Warning);
            return;
        }

        // A programmatic run has just written the tab's SQL, and the editor can still show the old text
        // until it renders again. Reading the editor back then would replace the new SQL with the old.
        if (mode != RunMode.Tab)
            await PersistActiveEditorAsync();

        QueryTab tab = ActiveTab;
        string tabSql = tab.Sql ?? "";

        string? selected = null;
        int? cursor = null;
        if (mode != RunMode.Tab && _editor is not null)
        {
            try
            {
                selected = await _editor.GetSelectedTextAsync();
                if (selected is null && mode == RunMode.Statement)
                    cursor = await _editor.GetCursorOffsetAsync();
            }
            catch
            {
                // Fall back to the whole tab if the editor is mid-teardown.
            }
        }

        List<string> statements;
        if (selected is not null)
            statements = SqlScript.Split(selected).Select(st => st.Text).ToList();
        else if (mode == RunMode.Statement && cursor is int offset)
            statements = SqlScript.StatementAt(tabSql, offset) is { } current ? [current.Text] : [];
        else
            statements = SqlScript.Split(tabSql).Select(st => st.Text).ToList();

        if (statements.Count == 0)
        {
            Snackbar.Add("SQL is empty.", Severity.Warning);
            return;
        }

        // The title names the tab, so keep it on the tab's own SQL rather than the selected fragment.
        if (tab.DataContext is null && selected is null)
            tab.Title = TruncateTitle(tabSql);

        await PersistTabsAsync();

        _running = true;
        _cts = new CancellationTokenSource();
        CancellationToken token = _cts.Token;
        tab.ClearResults();
        StateHasChanged();

        // The schema tree loads again once, after the whole run, not after each statement of a script.
        bool databaseListChanged = false;
        HashSet<string> changedDatabases = new(StringComparer.OrdinalIgnoreCase);

        try
        {
            for (int i = 0; i < statements.Count; i++)
            {
                if (token.IsCancellationRequested)
                {
                    tab.SkippedStatements = statements.Count - i;
                    break;
                }

                string sql = statements[i];
                string database = Session.Database;
                QueryResultModel result = await Queries.ExecutePagedAsync(sql, token);

                tab.Results.Add(new StatementRun(sql, result));
                tab.ActiveResult = tab.Results.Count - 1;

                await History.AddAsync(sql, Session.Database, result);

                SchemaEffect effect = result.Success ? SqlScript.SchemaEffectOf(sql) : SchemaEffect.None;
                if (effect != SchemaEffect.None)
                {
                    Completion.Invalidate();

                    if (effect == SchemaEffect.Databases)
                        databaseListChanged = true;
                    else
                        changedDatabases.Add(database);
                }

                if (!result.Success)
                {
                    tab.SkippedStatements = statements.Count - i - 1;
                    string where = statements.Count > 1 ? $"Statement {i + 1} of {statements.Count} failed: " : "";
                    string skipped = tab.SkippedStatements > 0
                        ? $" — {tab.SkippedStatements} statement{(tab.SkippedStatements == 1 ? " was" : "s were")} not run."
                        : "";
                    Snackbar.Add(where + (result.ErrorMessage ?? "Query failed") + skipped, Severity.Error);
                    break;
                }

                if (statements.Count > 1)
                    StateHasChanged();
            }
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }

        if (databaseListChanged || changedDatabases.Count > 0)
            SchemaChanges.Notify(new SchemaChange { DatabaseList = databaseListChanged, Databases = changedDatabases });
    }

    private Task RefreshActiveDataAsync() => RunCoreAsync(RunMode.Tab);

    /// <summary>Gets the next page of the shown result and adds its rows to the grid.</summary>
    private async Task FetchMoreAsync()
    {
        QueryTab? tab = ActiveTab;
        if (tab is null || _running || tab.ActiveResult >= tab.Results.Count)
            return;

        int index = tab.ActiveResult;
        StatementRun run = tab.Results[index];
        if (!run.Result.HasMore)
            return;

        _running = true;
        _cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            QueryResultModel more = await Queries.FetchMoreAsync(run.Result, _cts.Token);
            if (!more.Success)
            {
                Snackbar.Add(more.ErrorMessage ?? "Could not get the next rows.", Severity.Error);
                return;
            }

            // The tab can have run again while the page was loading; then the page belongs to nothing.
            if (index < tab.Results.Count && ReferenceEquals(tab.Results[index], run))
                tab.Results[index] = run with { Result = more };
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
            StateHasChanged();
        }
    }

    private async Task ApplyDataFilterAsync(string where)
    {
        QueryTab? tab = ActiveTab;
        if (tab?.DataContext is null || _running)
            return;

        string? condition = string.IsNullOrWhiteSpace(where) ? null : where.Trim();
        string sql = SqlBuilder.BuildTableQuery(tab.DataContext.Table, condition, tab.DataOrderBy, tab.DataDescending);

        // The condition is written into the statement as typed. A ';' would make it two statements.
        if (SqlScript.Split(sql).Count != 1)
        {
            Snackbar.Add("The filter must be one condition, without ';'.", Severity.Warning);
            return;
        }

        tab.DataWhere = condition;
        await RunDataQueryAsync(tab, sql);
    }

    private async Task ApplyDataSortAsync(GridSort sort)
    {
        QueryTab? tab = ActiveTab;
        if (tab?.DataContext is null || _running)
            return;

        tab.DataOrderBy = sort.Column;
        tab.DataDescending = sort.Column is not null && sort.Descending;
        string sql = SqlBuilder.BuildTableQuery(tab.DataContext.Table, tab.DataWhere, tab.DataOrderBy, tab.DataDescending);
        await RunDataQueryAsync(tab, sql);
    }

    /// <summary>Writes the data tab's new query into its editor, as the SQL the grid shows, and runs it.</summary>
    private async Task RunDataQueryAsync(QueryTab tab, string sql)
    {
        tab.Sql = sql;
        await PersistTabsAsync();
        _hasSelection = false;
        StateHasChanged();
        await RunCoreAsync(RunMode.Tab);
    }

    private async Task OpenHistoryAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
        };

        IDialogReference dialog = await DialogService.ShowAsync<QueryHistoryDialog>("Query history", options);
        DialogResult? result = await dialog.Result;
        if (result is { Canceled: false, Data: string sql })
        {
            await PersistActiveEditorAsync();
            AddTabCore(selectSql: sql);
            StateHasChanged();
        }
    }

    private void CancelRun() => _cts?.Cancel();

    private void OnSplitPointerDown(PointerEventArgs e)
    {
        _splitting = true;
        _splitStartY = e.ClientY;
        _splitStartHeight = _editorHeight;
    }

    private void OnSplitPointerMove(PointerEventArgs e)
    {
        if (!_splitting)
            return;

        int next = _splitStartHeight + (int)(e.ClientY - _splitStartY);
        int clamped = Math.Clamp(next, 120, 700);
        if (clamped != _editorHeight)
            _editorHeight = clamped;
    }

    private void OnSplitPointerUp(PointerEventArgs e)
    {
        _splitting = false;
        _ = Prefs.SetEditorHeightAsync(_editorHeight);
    }

    private static string TruncateTitle(string sql)
    {
        string oneLine = sql.Replace('\n', ' ').Replace('\r', ' ').Trim();
        if (oneLine.Length == 0)
            return "SQL";
        return oneLine.Length <= 28 ? oneLine : oneLine[..28] + "…";
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _cts?.Cancel();
        _cts?.Dispose();
        _completionRef?.Dispose();

        if (_hydrated && _tabs.Count > 0)
        {
            // Best-effort flush of the latest SQL before the circuit tears down.
            _ = PersistTabsAsync();
        }
    }

    private sealed class QueryTab
    {
        public required string Id { get; init; }
        public string Title { get; set; } = "SQL";
        public string Sql { get; set; } = "";

        /// <summary>One entry for each statement of the last run, in order.</summary>
        public List<StatementRun> Results { get; } = [];

        /// <summary>The index in <see cref="Results"/> of the result the grid shows.</summary>
        public int ActiveResult { get; set; }

        /// <summary>The statements of the last run that did not run, after a failure or a stop.</summary>
        public int SkippedStatements { get; set; }

        public QueryResultModel? LastResult =>
            ActiveResult < Results.Count ? Results[ActiveResult].Result : null;

        public TableDataContext? DataContext { get; set; }

        /// <summary>The WHERE condition of a data tab, or null.</summary>
        public string? DataWhere { get; set; }

        /// <summary>The ORDER BY column of a data tab, or null.</summary>
        public string? DataOrderBy { get; set; }

        public bool DataDescending { get; set; }

        public void ClearResults()
        {
            Results.Clear();
            ActiveResult = 0;
            SkippedStatements = 0;
        }
    }

    private sealed record StatementRun(string Sql, QueryResultModel Result);
}
