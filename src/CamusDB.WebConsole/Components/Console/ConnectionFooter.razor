@inject CamusSessionService Session
@inject ConsoleBranding Branding
@implements IDisposable

<footer class="console-footer">
    <span>@Branding.Name</span>
    <span>
        <span class="conn-dot @(Session.IsConnected ? "on" : "off")"></span>
        @(Session.IsConnected ? "Connected" : "Disconnected")
        @* Not shown when the deployment locked it. A visitor cannot change that endpoint, so the
           address tells them nothing they can act on — and on a console reachable from the internet
           it is a description of the operator's internal network, printed on every page. *@
        @if (!Session.EndpointLocked && !string.IsNullOrEmpty(Session.Endpoint))
        {
            <text> · @Session.Endpoint</text>
        }
        @if (Session.IsConnected && !string.IsNullOrEmpty(Session.ServerVersion))
        {
            <text> · v</text>@Session.ServerVersion
        }
        @if (Session.IsAuthenticated)
        {
            <text> · </text>@(Session.UsesSuppliedToken ? "token auth" : Session.User)
        }
        else if (Session.IsConnected)
        {
            <text> · no auth</text>
        }
        @if (!Session.IsConnected && !string.IsNullOrEmpty(Session.LastError))
        {
            <text> · @Session.LastError</text>
        }
    </span>
</footer>

@code {
    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
