@inject QueryExecutionService Queries
@inject SchemaExplorerService Schema
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Create table</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3" Class="mt-2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Database: @_database</MudText>
            <MudTextField @bind-Value="_tableName"
                          Label="Table name"
                          Variant="Variant.Outlined"
                          Immediate="true" />
            <MudTextField @bind-Value="_tableComment"
                          Label="Table comment (optional)"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          MaxLength="SqlBuilder.MaxCommentLength" />

            <MudText Typo="Typo.subtitle2">Columns</MudText>
            @foreach (ColumnDraft col in _columns)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudTextField @bind-Value="col.Name"
                                  Label="Name"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Style="flex:1; min-width:90px;" />
                    <MudSelect T="string"
                               @bind-Value="col.Type"
                               Label="Type"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="width:120px;">
                        @foreach (string t in SqlBuilder.ColumnTypes)
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField @bind-Value="col.Default"
                                  Label="Default"
                                  Placeholder="@SqlBuilder.DefaultPlaceholder(col.Type)"
                                  HelperText="@SqlBuilder.DefaultFunctionHint(col.Type)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  Style="width:150px;" />
                    <MudTextField @bind-Value="col.Comment"
                                  Label="Comment"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Immediate="true"
                                  MaxLength="SqlBuilder.MaxCommentLength"
                                  Style="flex:1; min-width:110px;" />
                    <MudCheckBox @bind-Value="col.NotNull" Label="NOT NULL" Dense="true" />
                    <MudCheckBox @bind-Value="col.PrimaryKey" Label="PK" Dense="true" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Disabled="_columns.Count <= 1"
                                   OnClick="() => RemoveColumn(col)"
                                   aria-label="Remove column" />
                </MudStack>
            }

            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddColumn">
                Add column
            </MudButton>

            <MudText Typo="Typo.subtitle2">Foreign keys</MudText>
            @foreach (ForeignKeyDraft fk in _foreignKeys)
            {
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudSelect T="string"
                               @bind-Value="fk.Column"
                               Label="Column"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex:1; min-width:90px;">
                        @foreach (string name in _columns.Select(c => c.Name.Trim()).Where(n => n.Length > 0).Distinct(StringComparer.OrdinalIgnoreCase))
                        {
                            <MudSelectItem Value="@name">@name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               Value="fk.ReferencedTable"
                               ValueChanged="t => OnReferencedTableChangedAsync(fk, t)"
                               Label="References"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex:1; min-width:110px;">
                        @foreach (string t in ReferenceableTables())
                        {
                            <MudSelectItem Value="@t">@t</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string"
                               @bind-Value="fk.ReferencedColumn"
                               Label="Referenced column"
                               Placeholder="primary key"
                               Clearable="true"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex:1; min-width:110px;">
                        @foreach (string name in ParentColumns(fk))
                        {
                            <MudSelectItem Value="@name">@name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="fk.OnDelete" Label="ON DELETE" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                        @foreach (string action in SqlForeignKeyActions.Supported)
                        {
                            <MudSelectItem Value="@action">@action</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="string" @bind-Value="fk.OnUpdate" Label="ON UPDATE" Variant="Variant.Outlined" Margin="Margin.Dense" Style="width:120px;">
                        @foreach (string action in SqlForeignKeyActions.Supported)
                        {
                            <MudSelectItem Value="@action">@action</MudSelectItem>
                        }
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   OnClick="() => _foreignKeys.Remove(fk)"
                                   aria-label="Remove foreign key" />
                </MudStack>
            }

            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Link"
                       OnClick="() => _foreignKeys.Add(new ForeignKeyDraft())">
                Add foreign key
            </MudButton>

            <MudField Label="SQL preview" Variant="Variant.Outlined">
                <pre class="sql-preview">@(Preview() ?? "-- fill in a table name --")</pre>
            </MudField>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_busy">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="CreateAsync"
                   Disabled="_busy"
                   Class="run-btn">
            @(_busy ? "Creating…" : "Create")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public string Database { get; set; } = "";

    /// <summary>The existing tables of the database, offered as the parent of a foreign key.</summary>
    [Parameter]
    public IReadOnlyList<string> Tables { get; set; } = [];

    private string _database = "";
    private string _tableName = "";
    private string _tableComment = "";
    private readonly List<ColumnDraft> _columns = [];
    private readonly List<ForeignKeyDraft> _foreignKeys = [];
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        _database = Database;
        _columns.Add(new ColumnDraft { Name = "id", Type = "OID", NotNull = true, PrimaryKey = true });
        _columns.Add(new ColumnDraft { Name = "name", Type = "STRING", NotNull = true });
    }

    private void AddColumn() =>
        _columns.Add(new ColumnDraft { Name = "", Type = "STRING" });

    private void RemoveColumn(ColumnDraft col) => _columns.Remove(col);

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// The existing tables, plus the new table itself once it has a name: a self-reference is legal.
    /// </summary>
    private IEnumerable<string> ReferenceableTables()
    {
        string self = _tableName.Trim();
        if (self.Length > 0 && !Tables.Contains(self, StringComparer.OrdinalIgnoreCase))
            yield return self;

        foreach (string t in Tables)
            yield return t;
    }

    private bool IsSelfReference(ForeignKeyDraft fk) =>
        fk.ReferencedTable is not null
        && fk.ReferencedTable.Equals(_tableName.Trim(), StringComparison.OrdinalIgnoreCase);

    /// <summary>
    /// The columns of the parent. A self-reference reads the columns drafted in this dialog, so a
    /// rename there shows at once.
    /// </summary>
    private IEnumerable<string> ParentColumns(ForeignKeyDraft fk) =>
        IsSelfReference(fk)
            ? _columns.Select(c => c.Name.Trim()).Where(n => n.Length > 0)
            : fk.ParentColumns;

    private async Task OnReferencedTableChangedAsync(ForeignKeyDraft fk, string table)
    {
        fk.ReferencedTable = table;
        fk.ReferencedColumn = null;
        fk.ParentColumns = [];

        if (string.IsNullOrWhiteSpace(table) || IsSelfReference(fk))
            return;

        try
        {
            fk.ParentColumns = (await Schema.ListColumnsAsync(table)).Select(c => c.Name).ToList();
        }
        catch
        {
            // The column stays "primary key", which needs no column list.
        }
    }

    private string? Preview()
    {
        if (!TryBuild(out string? sql, out _))
            return null;

        return sql;
    }

    /// <summary>
    /// Validates every field and renders the statement, or reports the first problem. Shared by the
    /// preview (which discards the error) and Create (which shows it).
    /// </summary>
    private bool TryBuild(out string? sql, out string? error)
    {
        sql = null;
        error = null;

        if (string.IsNullOrWhiteSpace(_tableName))
        {
            error = "Table name is required.";
            return false;
        }

        if (!SqlBuilder.TryValidateComment(NullIfEmpty(_tableComment), out error))
            return false;

        List<ColumnDefinition> cols = [];
        foreach (ColumnDraft c in _columns)
        {
            if (string.IsNullOrWhiteSpace(c.Name))
            {
                error = "Every column needs a name.";
                return false;
            }

            if (string.IsNullOrWhiteSpace(c.Type))
            {
                error = $"Column '{c.Name}' needs a type.";
                return false;
            }

            if (!SqlBuilder.TryBuildDefaultExpression(c.Default, c.Type, out string? defaultExpr, out string? defaultError))
            {
                error = $"Column '{c.Name}': {defaultError}";
                return false;
            }

            string? comment = NullIfEmpty(c.Comment);
            if (!SqlBuilder.TryValidateComment(comment, out string? commentError))
            {
                error = $"Column '{c.Name}': {commentError}";
                return false;
            }

            cols.Add(new ColumnDefinition(
                c.Name.Trim(),
                c.Type.Trim(),
                c.NotNull || c.PrimaryKey,
                c.PrimaryKey,
                defaultExpr,
                comment));
        }

        List<ForeignKeyDefinition> foreignKeys = [];
        foreach (ForeignKeyDraft fk in _foreignKeys)
        {
            if (string.IsNullOrWhiteSpace(fk.Column) || string.IsNullOrWhiteSpace(fk.ReferencedTable))
            {
                error = "Every foreign key needs a column and a referenced table.";
                return false;
            }

            if (!cols.Any(c => c.Name.Equals(fk.Column, StringComparison.OrdinalIgnoreCase)))
            {
                error = $"Foreign key column '{fk.Column}' is not a column of the table.";
                return false;
            }

            foreignKeys.Add(new ForeignKeyDefinition(
                null,
                [fk.Column],
                fk.ReferencedTable,
                string.IsNullOrWhiteSpace(fk.ReferencedColumn) ? [] : [fk.ReferencedColumn],
                fk.OnDelete,
                fk.OnUpdate));
        }

        try
        {
            sql = SqlBuilder.BuildCreateTable(_tableName.Trim(), cols, NullIfEmpty(_tableComment), foreignKeys);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            return false;
        }

        return true;
    }

    private static string? NullIfEmpty(string? value) =>
        string.IsNullOrEmpty(value) ? null : value;

    private async Task CreateAsync()
    {
        _error = null;

        if (!TryBuild(out string? sql, out string? error))
        {
            _error = error;
            return;
        }

        _busy = true;
        try
        {
            QueryResultModel result = await Queries.ExecuteAsync(sql!);
            if (!result.Success)
            {
                _error = result.ErrorMessage ?? "Create table failed.";
                return;
            }

            Snackbar.Add($"Table '{_tableName.Trim()}' created.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ColumnDraft
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "STRING";
        public string Default { get; set; } = "";
        public string Comment { get; set; } = "";
        public bool NotNull { get; set; }
        public bool PrimaryKey { get; set; }
    }

    /// <summary>
    /// One single-column foreign key. A composite key needs Add a Foreign Key on the table after it
    /// exists, or SQL in the editor. A null <c>ReferencedColumn</c> references the primary key.
    /// </summary>
    private sealed class ForeignKeyDraft
    {
        public string? Column { get; set; }
        public string? ReferencedTable { get; set; }
        public string? ReferencedColumn { get; set; }
        public List<string> ParentColumns { get; set; } = [];
        public string OnDelete { get; set; } = SqlForeignKeyActions.NoAction;
        public string OnUpdate { get; set; } = SqlForeignKeyActions.NoAction;
    }
}
