@inject IJSRuntime JS

<div class="query-editor-host" style="height: 100%;">
    <StandaloneCodeEditor @ref="_editor"
                          Id="@EditorId"
                          ConstructionOptions="ConstructionOptions"
                          OnDidInit="OnDidInitAsync"
                          OnDidChangeModelContent="OnDidChangeModelContentAsync"
                          OnDidChangeCursorSelection="OnDidChangeCursorSelectionAsync"
                          CssClass="sql-monaco" />
</div>

@code {
    [Parameter]
    public string EditorId { get; set; } = "sql-editor";

    [Parameter]
    public string Value { get; set; } = "";

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Ctrl/Cmd+Enter: run the selection, or the statement at the cursor.</summary>
    [Parameter]
    public EventCallback OnRunRequested { get; set; }

    /// <summary>Alt+X: run every statement of the selection, or of the whole tab.</summary>
    [Parameter]
    public EventCallback OnRunScriptRequested { get; set; }

    /// <summary>Gives the completion list the tables and columns of the session database.</summary>
    [Parameter]
    public DotNetObjectReference<SchemaCompletionSource>? CompletionSource { get; set; }

    /// <summary>
    /// Raised when the editor gains or loses a non-empty selection, so the toolbar can say whether
    /// running will execute the selection or the whole tab.
    /// </summary>
    [Parameter]
    public EventCallback<bool> HasSelectionChanged { get; set; }

    private StandaloneCodeEditor? _editor;
    private bool _ready;
    private string _lastSet = "";
    private bool _suppressChange;
    private bool _hasSelection;

    private StandaloneEditorConstructionOptions ConstructionOptions(StandaloneCodeEditor _)
    {
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            // CamusDB-specific SQL mode registered by wwwroot/js/camus-sql.js.
            Language = "camussql",
            // vs-dark plus the console's string/quoted-identifier colors; defined in camus-sql.js.
            Theme = "camus-dark",
            Value = Value ?? "",
            Minimap = new EditorMinimapOptions { Enabled = false },
            FontFamily = "IBM Plex Mono, Menlo, Consolas, monospace",
            FontSize = 13,
            LineNumbers = "on",
            ScrollBeyondLastLine = false,
            WordWrap = "on",
            TabSize = 2,
            RenderLineHighlight = "line",
            Padding = new EditorPaddingOptions { Top = 8, Bottom = 8 },
        };
    }

    private async Task OnDidInitAsync()
    {
        _ready = true;
        _lastSet = Value ?? "";

        // monaco's AMD modules resolve asynchronously, so the camussql language may not have existed
        // when this editor was constructed. By now monaco is definitely loaded; retag the model.
        try
        {
            await JS.InvokeAsync<bool>("camusSql.applyToEditor", EditorId);
            await JS.InvokeVoidAsync("camusSql.setCompletionSource", CompletionSource);
        }
        catch (JSException)
        {
            // Highlighting and completion are conveniences — never let them break the editor.
        }

        if (_editor is not null)
        {
            await _editor.AddCommand((int)KeyMod.CtrlCmd | (int)KeyCode.Enter, async _ =>
            {
                await SyncValueAsync();
                await OnRunRequested.InvokeAsync();
            });

            await _editor.AddCommand((int)KeyMod.Alt | (int)KeyCode.KeyX, async _ =>
            {
                await SyncValueAsync();
                await OnRunScriptRequested.InvokeAsync();
            });
        }
    }

    private async Task OnDidChangeModelContentAsync(ModelContentChangedEvent _)
    {
        if (!_ready || _editor is null || _suppressChange)
            return;

        string value = await _editor.GetValue();
        if (value == _lastSet)
            return;

        _lastSet = value;
        await ValueChanged.InvokeAsync(value);
    }

    /// <summary>
    /// Monaco fires this on every cursor move, so only surface the transitions between "has a
    /// selection" and "does not" — the toolbar is the only thing that cares.
    /// </summary>
    private async Task OnDidChangeCursorSelectionAsync(CursorSelectionChangedEvent e)
    {
        bool hasSelection = e.Selection is { } s
            && (s.StartLineNumber != s.EndLineNumber || s.StartColumn != s.EndColumn);

        if (hasSelection == _hasSelection)
            return;

        _hasSelection = hasSelection;
        await HasSelectionChanged.InvokeAsync(hasSelection);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_ready || _editor is null)
            return;

        string next = Value ?? "";
        if (next == _lastSet)
            return;

        string current = await _editor.GetValue();
        if (current == next)
        {
            _lastSet = next;
            return;
        }

        _suppressChange = true;
        try
        {
            await _editor.SetValue(next);
            _lastSet = next;
        }
        finally
        {
            _suppressChange = false;
        }
    }

    public async Task<string> GetValueAsync()
    {
        if (_editor is null || !_ready)
            return Value ?? "";

        string value = await _editor.GetValue();
        _lastSet = value;
        return value;
    }

    /// <summary>
    /// The currently selected text, or <c>null</c> when nothing (or only whitespace) is selected.
    /// Read at run time rather than tracked, so it always reflects what the user can see.
    /// </summary>
    public async Task<string?> GetSelectedTextAsync()
    {
        if (_editor is null || !_ready)
            return null;

        Selection? selection = await _editor.GetSelection();
        if (selection is null)
            return null;

        TextModel? model = await _editor.GetModel();
        if (model is null)
            return null;

        string selected = await model.GetValueInRange(selection, EndOfLinePreference.TextDefined);
        return string.IsNullOrWhiteSpace(selected) ? null : selected;
    }

    /// <summary>The cursor position as a character offset into the editor text, or null.</summary>
    public async Task<int?> GetCursorOffsetAsync()
    {
        if (_editor is null || !_ready)
            return null;

        BlazorMonaco.Position? position = await _editor.GetPosition();
        TextModel? model = await _editor.GetModel();
        if (position is null || model is null)
            return null;

        return await model.GetOffsetAt(position);
    }

    public async Task SyncValueAsync()
    {
        string value = await GetValueAsync();
        if (value != Value)
            await ValueChanged.InvokeAsync(value);
    }
}
