@* Draws an EXPLAIN result as a flow: the source at the top, each operator below the one that feeds
   it, and the result at the bottom. An edge carries the number of rows its upper node produces.
   A set operation has two inputs that both have rows: each operand is a box above the set
   operation, with the operand's own flow inside it, so a nested set operation nests its boxes.
   A join whose right input has a plan of its own (a derived table) gets the same two boxes: its
   left input and its right input. *@

<div class="plan-flow-wrap">
    <div class="plan-summary">
        <span class="plan-stage">@Plan.Stage</span>
        <span>@_operators operator@(_operators == 1 ? "" : "s")</span>
        @if (Plan.TotalEstimatedCost > 0)
        {
            <span>Estimated cost: <strong>@FormatCost(Plan.TotalEstimatedCost)</strong></span>
        }
        @if (Plan.TotalTimeMs is double ms)
        {
            <span>Measured time: <strong>@FormatMs(ms)</strong></span>
        }
        @if (Plan.PlanningMs is double planning)
        {
            <span>Planning: <strong>@FormatMs(planning)</strong></span>
        }
        <span class="plan-hint">Rows flow from top to bottom.</span>
    </div>

    <ol class="plan-flow @ChainClass(Plan.Nodes)" aria-label="Query plan, from the source to the result">
        @Steps(Plan.Nodes)
        <li class="plan-step kind-result">
            @Edge(Plan.Nodes[^1])
            <div class="plan-result">Result</div>
        </li>
    </ol>

    @if (Plan.Notes.Count > 0)
    {
        <dl class="plan-notes">
            @foreach (QueryPlanNote note in Plan.Notes)
            {
                <div class="plan-note">
                    <dt>@QueryPlanText.NoteLabel(note.Name)</dt>
                    <dd>@note.Detail</dd>
                </div>
            }
        </dl>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public QueryPlanModel Plan { get; set; } = default!;

    private QueryPlanNode? _hottest;
    private int _operators;

    protected override void OnParametersSet()
    {
        List<QueryPlanNode> all = Plan.AllNodes.ToList();
        _operators = all.Count;

        // The badge marks one operator that costs more than each of the others. With one costed
        // operator, or with a tie at the top, there is nothing to single out.
        List<QueryPlanNode> costed = all
            .Where(n => n.EstimatedCost > 0)
            .OrderByDescending(n => n.EstimatedCost)
            .ToList();
        _hottest = costed.Count > 1 && costed[0].EstimatedCost > costed[1].EstimatedCost ? costed[0] : null;
    }

    /// <summary>
    /// The layout classes of one chain: <c>has-side</c> makes room for the side boxes of its joins,
    /// and <c>has-branches</c> for the input boxes of its set operation or of a join whose right input
    /// has a plan.
    /// </summary>
    private static string ChainClass(IReadOnlyList<QueryPlanNode> nodes) => string.Join(' ', new[]
    {
        nodes.Any(HasSideBox) ? "has-side" : null,
        nodes.Any(n => n.Branches.Count > 0 || n.SideBranches.Count > 0) ? "has-branches" : null,
    }.Where(c => c is not null));

    /// <summary>A join whose right input has no rows of its own gets a dashed box beside it.</summary>
    private static bool HasSideBox(QueryPlanNode node) => node.SideInput is not null && node.SideBranches.Count == 0;

    /// <summary>
    /// The steps of one chain, each with the edge from the step above it. The last join whose right
    /// input has a plan splits the chain: the steps before it go in its <i>Left input</i> box, which
    /// splits again at the join before it.
    /// </summary>
    private RenderFragment Steps(IReadOnlyList<QueryPlanNode> nodes) => __builder =>
    {
        int split = -1;
        for (int i = nodes.Count - 1; i >= 0 && split < 0; i--)
        {
            if (nodes[i].SideBranches.Count > 0)
                split = i;
        }

        if (split >= 0)
        {
            @Inputs(nodes[split], nodes.Take(split).ToList())
        }

        for (int i = Math.Max(split, 0); i < nodes.Count; i++)
        {
            QueryPlanNode node = nodes[i];
            QueryPlanNode? upstream = i > 0 && i != split ? nodes[i - 1] : null;

            if (node.Branches.Count > 0)
            {
                @Branches(node)
            }

            @Step(node, upstream)
        }
    };

    /// <summary>
    /// The input boxes of a join whose right input has a plan of its own: the left input (the steps of
    /// the chain before the join) and each right input, side by side when there is room.
    /// </summary>
    private RenderFragment Inputs(QueryPlanNode join, IReadOnlyList<QueryPlanNode> left) => __builder =>
    {
        <li class="plan-branches plan-inputs">
            @if (left.Count > 0)
            {
                @InputBox("Left input", null, left)
            }
            @foreach (IReadOnlyList<QueryPlanNode> right in join.SideBranches)
            {
                @InputBox(join.SideInput ?? "Right input", join.SideDetail, right)
            }
        </li>
    };

    private RenderFragment InputBox(string title, string? detail, IReadOnlyList<QueryPlanNode> nodes) => __builder =>
    {
        <section class="plan-operand" aria-label="@title">
            <div class="plan-operand-title">@title</div>
            @if (detail is not null)
            {
                <div class="plan-side-detail">@detail</div>
            }
            <ol class="plan-flow plan-flow-nested @ChainClass(nodes)">
                @Steps(nodes)
                <li class="plan-step">
                    @Edge(nodes[^1].ActualRows, nodes[^1].EstimatedRows, $"Rows that the {title.ToLowerInvariant()} returns")
                </li>
            </ol>
        </section>
    };

    /// <summary>
    /// The operand boxes of a set operation, side by side when there is room. The last edge in a box
    /// carries the rows the operand returns. The operand row counts them under ANALYZE; plain EXPLAIN
    /// gives the operand no count, so the estimate of the operand's last operator stands.
    /// </summary>
    private RenderFragment Branches(QueryPlanNode setOperation) => __builder =>
    {
        <li class="plan-branches">
            @foreach (QueryPlanBranch branch in setOperation.Branches)
            {
                string title = QueryPlanText.OperandTitle(setOperation, branch);

                <section class="plan-operand" aria-label="@title">
                    <div class="plan-operand-title">@title</div>
                    @if (branch.Nodes.Count > 0)
                    {
                        QueryPlanNode last = branch.Nodes[^1];

                        <ol class="plan-flow plan-flow-nested @ChainClass(branch.Nodes)">
                            @Steps(branch.Nodes)
                            <li class="plan-step">
                                @Edge(branch.Operand.ActualRows ?? last.ActualRows,
                                    branch.Operand.EstimatedRows ?? last.EstimatedRows,
                                    $"Rows that the {title.ToLowerInvariant()} returns")
                            </li>
                        </ol>
                    }
                    else
                    {
                        <div class="plan-desc">The plan shows no operator for this operand.</div>
                    }
                </section>
            }
        </li>
    };

    /// <summary>
    /// One operator, with the edge from <paramref name="upstream"/>. A set operation, and a join whose
    /// right input has a plan, has no upstream node: its edge comes from the boxes above it and carries
    /// no label.
    /// </summary>
    private RenderFragment Step(QueryPlanNode node, QueryPlanNode? upstream) => __builder =>
    {
        double? share = CostShare(node);

        <li class="plan-step @KindClass(node.Kind)">
            @if (upstream is not null)
            {
                @Edge(upstream)
            }
            else if (node.Branches.Count > 0 || node.SideBranches.Count > 0)
            {
                @Edge(null, null, null)
            }
            <div class="plan-node @(node == _hottest ? "hot" : null)">
                <div class="plan-node-head">
                    <span class="plan-kind-label">@QueryPlanText.KindLabel(node.Kind)</span>
                    <span class="plan-op">@node.Operator</span>
                    @if (node.Target is not null)
                    {
                        <span class="plan-target">@node.Target</span>
                    }
                    @if (node.ComputedOnce is string withQuery)
                    {
                        <span class="plan-badge info" title="The statement computes the WITH query @withQuery one time. The first reader keeps its rows, and each other reader reads the kept rows.">Computed once: @withQuery</span>
                    }
                    @if (node == _hottest)
                    {
                        <span class="plan-badge hot" title="This operator has the highest estimated cost in the plan.">Highest cost</span>
                    }
                    @if (QueryPlanText.EstimateMiss(node) is string miss)
                    {
                        <span class="plan-badge warn" title="The planner's row estimate and the measured row count are far apart.">@miss</span>
                    }
                </div>
                @if (QueryPlanText.Describe(node.Operator) is string description)
                {
                    <div class="plan-desc">@description</div>
                }
                @if (node.Detail.Length > 0)
                {
                    <div class="plan-detail">@node.Detail</div>
                }
                @if (HasMetrics(node, share))
                {
                    <div class="plan-metrics">
                        @if (share is double s)
                        {
                            <span>est. cost <strong>@FormatCost(node.EstimatedCost!.Value)</strong> (@FormatShare(s))</span>
                        }
                        @if (QueryPlanText.Counter(node, node.RowsRead) is long read)
                        {
                            <span>rows read <strong>@read.ToString("N0")</strong></span>
                        }
                        @if (QueryPlanText.Counter(node, node.KvLookups) is long lookups)
                        {
                            <span>KV lookups <strong>@lookups.ToString("N0")</strong></span>
                        }
                        @if (QueryPlanText.Counter(node, node.KvScanEntries) is long entries)
                        {
                            <span>KV scan entries <strong>@entries.ToString("N0")</strong></span>
                        }
                    </div>
                }
                @if (share is double width)
                {
                    <div class="plan-cost-bar" title="Share of the plan's estimated cost">
                        <span style="@($"width:{Math.Max(width * 100, 1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                    </div>
                }
                @if (node.Spans.Count > 0)
                {
                    <ul class="plan-spans">
                        @foreach (QueryPlanSpan span in node.Spans)
                        {
                            <li>@span.Detail</li>
                        }
                    </ul>
                }
            </div>
            @if (HasSideBox(node))
            {
                <div class="plan-side">
                    <div class="plan-side-link" aria-hidden="true"></div>
                    <div class="plan-side-box">
                        <div class="plan-side-title">@node.SideInput</div>
                        @if (node.SideDetail is not null)
                        {
                            <div class="plan-side-detail">@node.SideDetail</div>
                        }
                    </div>
                </div>
            }
        </li>
    };

    /// <summary>The arrow out of <paramref name="from"/>. Its label and its width give the rows that node produces.</summary>
    private RenderFragment Edge(QueryPlanNode from) =>
        Edge(from.ActualRows, from.EstimatedRows, $"Rows that {from.Operator} produces");

    /// <summary>An arrow that carries the given rows. With no count at all, it has no label.</summary>
    private RenderFragment Edge(long? actualRows, long? estimatedRows, string? title) => __builder =>
    {
        long? rows = actualRows ?? estimatedRows;
        string? label = EdgeLabel(actualRows, estimatedRows);
        <div class="plan-edge" style="@($"--edge-w:{EdgeWidth(rows)}px")">
            <span class="plan-edge-line"></span>
            <span class="plan-edge-arrow"></span>
            @if (label is not null)
            {
                <span class="plan-edge-label" title="@title">@label</span>
            }
        </div>
    };

    private static string? EdgeLabel(long? actualRows, long? estimatedRows)
    {
        if (actualRows is long actual)
        {
            string text = $"{actual:N0} row{(actual == 1 ? "" : "s")}";
            return estimatedRows is long estimated ? $"{text} · est. {estimated:N0}" : text;
        }

        return estimatedRows is long rows ? $"est. {rows:N0} row{(rows == 1 ? "" : "s")}" : null;
    }

    // A log scale, so a million rows reads as a thick edge without a one-row edge disappearing.
    private static string EdgeWidth(long? rows)
    {
        double width = rows is long r and > 0 ? 1.5 + Math.Log10(r + 1) * 0.75 : 1.5;
        return Math.Min(width, 6).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>The node's part of the plan's estimated cost. Null for a node that costs nothing.</summary>
    private double? CostShare(QueryPlanNode node) =>
        Plan.TotalEstimatedCost > 0 && node.EstimatedCost is double cost and > 0 ? cost / Plan.TotalEstimatedCost : null;

    private static bool HasMetrics(QueryPlanNode node, double? share) =>
        share is not null
        || QueryPlanText.Counter(node, node.RowsRead) is not null
        || QueryPlanText.Counter(node, node.KvLookups) is not null
        || QueryPlanText.Counter(node, node.KvScanEntries) is not null;

    private static string FormatShare(double share) => QueryPlanText.FormatShare(share);

    private static string FormatCost(double cost) => QueryPlanText.FormatCost(cost);

    private static string FormatMs(double ms) => QueryPlanText.FormatMs(ms);

    private static string KindClass(PlanNodeKind kind) => QueryPlanText.KindClass(kind);
}
