@* Draws an EXPLAIN result as a flow: the source at the top, each operator below the one that feeds
   it, and the result at the bottom. An edge carries the number of rows its upper node produces. *@

<div class="plan-flow-wrap">
    <div class="plan-summary">
        <span class="plan-stage">@Plan.Stage</span>
        <span>@Plan.Nodes.Count operator@(Plan.Nodes.Count == 1 ? "" : "s")</span>
        @if (Plan.TotalEstimatedCost > 0)
        {
            <span>Estimated cost: <strong>@FormatCost(Plan.TotalEstimatedCost)</strong></span>
        }
        @if (Plan.TotalTimeMs is double ms)
        {
            <span>Measured time: <strong>@FormatMs(ms)</strong></span>
        }
        <span class="plan-hint">Rows flow from top to bottom.</span>
    </div>

    <ol class="plan-flow @(_hasSideInputs ? "has-side" : null)" aria-label="Query plan, from the source to the result">
        @for (int i = 0; i < Plan.Nodes.Count; i++)
        {
            QueryPlanNode node = Plan.Nodes[i];
            QueryPlanNode? upstream = i > 0 ? Plan.Nodes[i - 1] : null;
            double? share = CostShare(node);

            <li class="plan-step @KindClass(node.Kind)">
                @if (upstream is not null)
                {
                    @Edge(upstream)
                }
                <div class="plan-node @(node == _hottest ? "hot" : null)">
                    <div class="plan-node-head">
                        <span class="plan-kind-label">@KindLabel(node.Kind)</span>
                        <span class="plan-op">@node.Operator</span>
                        @if (node.Target is not null)
                        {
                            <span class="plan-target">@node.Target</span>
                        }
                        @if (node == _hottest)
                        {
                            <span class="plan-badge hot" title="This operator has the highest estimated cost in the plan.">Highest cost</span>
                        }
                        @if (EstimateMiss(node) is string miss)
                        {
                            <span class="plan-badge warn" title="The planner's row estimate and the measured row count are far apart.">@miss</span>
                        }
                    </div>
                    @if (Describe(node.Operator) is string description)
                    {
                        <div class="plan-desc">@description</div>
                    }
                    @if (node.Detail.Length > 0)
                    {
                        <div class="plan-detail">@node.Detail</div>
                    }
                    @if (HasMetrics(node, share))
                    {
                        <div class="plan-metrics">
                            @if (share is double s)
                            {
                                <span>est. cost <strong>@FormatCost(node.EstimatedCost!.Value)</strong> (@FormatShare(s))</span>
                            }
                            @if (Counter(node, node.RowsRead) is long read)
                            {
                                <span>rows read <strong>@read.ToString("N0")</strong></span>
                            }
                            @if (Counter(node, node.KvLookups) is long lookups)
                            {
                                <span>KV lookups <strong>@lookups.ToString("N0")</strong></span>
                            }
                            @if (Counter(node, node.KvScanEntries) is long entries)
                            {
                                <span>KV scan entries <strong>@entries.ToString("N0")</strong></span>
                            }
                        </div>
                    }
                    @if (share is double width)
                    {
                        <div class="plan-cost-bar" title="Share of the plan's estimated cost">
                            <span style="@($"width:{Math.Max(width * 100, 1).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%")"></span>
                        </div>
                    }
                    @if (node.Spans.Count > 0)
                    {
                        <ul class="plan-spans">
                            @foreach (QueryPlanSpan span in node.Spans)
                            {
                                <li>@span.Detail</li>
                            }
                        </ul>
                    }
                </div>
                @if (node.SideInput is not null)
                {
                    <div class="plan-side">
                        <div class="plan-side-link" aria-hidden="true"></div>
                        <div class="plan-side-box">
                            <div class="plan-side-title">@node.SideInput</div>
                            @if (node.SideDetail is not null)
                            {
                                <div class="plan-side-detail">@node.SideDetail</div>
                            }
                        </div>
                    </div>
                }
            </li>
        }
        <li class="plan-step kind-result">
            @Edge(Plan.Nodes[^1])
            <div class="plan-result">Result</div>
        </li>
    </ol>

    @if (Plan.Notes.Count > 0)
    {
        <dl class="plan-notes">
            @foreach (QueryPlanNote note in Plan.Notes)
            {
                <div class="plan-note">
                    <dt>@NoteLabel(note.Name)</dt>
                    <dd>@note.Detail</dd>
                </div>
            }
        </dl>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public QueryPlanModel Plan { get; set; } = default!;

    private QueryPlanNode? _hottest;
    private bool _hasSideInputs;

    protected override void OnParametersSet()
    {
        _hasSideInputs = Plan.Nodes.Any(n => n.SideInput is not null);

        // The badge marks one operator that costs more than each of the others. With one costed
        // operator, or with a tie at the top, there is nothing to single out.
        List<QueryPlanNode> costed = Plan.Nodes
            .Where(n => n.EstimatedCost > 0)
            .OrderByDescending(n => n.EstimatedCost)
            .ToList();
        _hottest = costed.Count > 1 && costed[0].EstimatedCost > costed[1].EstimatedCost ? costed[0] : null;
    }

    /// <summary>The arrow out of <paramref name="from"/>. Its label and its width give the rows that node produces.</summary>
    private RenderFragment Edge(QueryPlanNode from) => __builder =>
    {
        long? rows = from.ActualRows ?? from.EstimatedRows;
        string? label = EdgeLabel(from);
        <div class="plan-edge" style="@($"--edge-w:{EdgeWidth(rows)}px")">
            <span class="plan-edge-line"></span>
            <span class="plan-edge-arrow"></span>
            @if (label is not null)
            {
                <span class="plan-edge-label" title="@($"Rows that {from.Operator} produces")">@label</span>
            }
        </div>
    };

    private static string? EdgeLabel(QueryPlanNode from)
    {
        if (from.ActualRows is long actual)
        {
            string text = $"{actual:N0} row{(actual == 1 ? "" : "s")}";
            return from.EstimatedRows is long estimated ? $"{text} · est. {estimated:N0}" : text;
        }

        return from.EstimatedRows is long rows ? $"est. {rows:N0} row{(rows == 1 ? "" : "s")}" : null;
    }

    // A log scale, so a million rows reads as a thick edge without a one-row edge disappearing.
    private static string EdgeWidth(long? rows)
    {
        double width = rows is long r and > 0 ? 1.5 + Math.Log10(r + 1) * 0.75 : 1.5;
        return Math.Min(width, 6).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    }

    /// <summary>The node's part of the plan's estimated cost. Null for a node that costs nothing.</summary>
    private double? CostShare(QueryPlanNode node) =>
        Plan.TotalEstimatedCost > 0 && node.EstimatedCost is double cost and > 0 ? cost / Plan.TotalEstimatedCost : null;

    /// <summary>
    /// ANALYZE reports the storage counters on every operator, and they are 0 on each one that
    /// does not touch storage. A zero is news on a source only, so the other operators leave it out.
    /// </summary>
    private static long? Counter(QueryPlanNode node, long? value) =>
        value is long v && (v > 0 || node.Kind == PlanNodeKind.Source) ? v : null;

    private static bool HasMetrics(QueryPlanNode node, double? share) =>
        share is not null
        || Counter(node, node.RowsRead) is not null
        || Counter(node, node.KvLookups) is not null
        || Counter(node, node.KvScanEntries) is not null;

    private static string FormatShare(double share) =>
        share < 0.005 ? "<1%" : $"{share * 100:0}%";

    /// <summary>
    /// A label when the measured rows are ten times the estimate or a tenth of it. Small counts are
    /// left out: 2 rows against an estimate of 25 is not worth a developer's attention.
    /// </summary>
    private static string? EstimateMiss(QueryPlanNode node)
    {
        if (node.ActualRows is not long actual || node.EstimatedRows is not long estimated)
            return null;

        long high = Math.Max(actual, estimated);
        long low = Math.Max(Math.Min(actual, estimated), 1);
        if (high < 100 || high / (double)low < 10)
            return null;

        return $"Estimate off {high / (double)low:0}×";
    }

    private static string FormatCost(double cost) => cost.ToString(cost >= 100 ? "N0" : "#,0.##");

    private static string FormatMs(double ms) =>
        ms < 1 ? $"{ms * 1000:0.##}μs" : ms < 1000 ? $"{ms:0.##}ms" : $"{ms / 1000:0.###}s";

    private static string KindClass(PlanNodeKind kind) => "kind-" + kind.ToString().ToLowerInvariant();

    private static string KindLabel(PlanNodeKind kind) => kind switch
    {
        PlanNodeKind.Source => "Source",
        PlanNodeKind.Join => "Join",
        PlanNodeKind.Filter => "Filter",
        PlanNodeKind.Aggregate => "Aggregate",
        PlanNodeKind.Sort => "Sort",
        PlanNodeKind.Limit => "Limit",
        PlanNodeKind.Project => "Output",
        PlanNodeKind.Exchange => "Exchange",
        _ => "Step",
    };

    private static string? Describe(string op) => op.ToLowerInvariant() switch
    {
        "table-scan" => "Reads every row of the table.",
        "index-lookup" => "Finds the rows for one exact index key.",
        "index-range-scan" => "Reads a range of keys from an index.",
        "index-in-list" => "Looks up each value of an IN list in an index.",
        "derived-table-scan" => "Reads the rows of a subquery in FROM.",
        "constant-source" => "Makes one row without reading a table.",
        "filter" => "Keeps only the rows that match the condition.",
        "having-filter" => "Keeps only the groups that match HAVING.",
        "aggregate" => "Groups the rows and computes the aggregates.",
        "distinct" => "Removes duplicate rows.",
        "sort" => "Sorts all the rows.",
        "topk" => "Keeps only the first k rows in sort order, without a full sort.",
        "limit" => "Stops after the row limit.",
        "project" => "Computes the output columns.",
        "nested-loop-join" => "Compares each left row with each right row.",
        "index-nested-loop-join" => "For each left row, finds the matching right rows through an index.",
        "hash-join" => "Puts one input in a hash table, then probes it with the other input.",
        "merge-join" => "Merges two inputs that are sorted on the join keys.",
        "semi-join" => "Keeps each row that has a match in the subquery (IN, EXISTS).",
        "anti-join" => "Keeps each row that has no match in the subquery (NOT IN, NOT EXISTS).",
        "null-aware-anti-join" => "Keeps each row that has no match in the subquery, with the NULL rules of NOT IN.",
        "gather" => "Collects the rows from the partitions of the cluster.",
        _ => null,
    };

    private static string NoteLabel(string name) => name.ToLowerInvariant() switch
    {
        "plan-info" => "Plan info",
        "distribution" => "Distribution",
        "cache" => "Result cache",
        _ => name,
    };
}
