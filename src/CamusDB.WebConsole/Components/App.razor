@using CamusDB.WebConsole.Endpoints
@using CamusDB.WebConsole.Models
@using CamusDB.WebConsole.Options
@using Microsoft.Extensions.Options
@inject ConsoleLaunchStore LaunchStore
@inject IOptions<ConsoleLaunchOptions> LaunchOptions

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["CamusDB.WebConsole.styles.css"]" />
    <link rel="stylesheet" href="css/console.css" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" BrandName="@_brandName" LaunchHandoff="@_launchHandoff" />
    <ReconnectModal />
    <script src="_content/BlazorMonaco/jsInterop.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/loader.js"></script>
    <script src="_content/BlazorMonaco/lib/monaco-editor/min/vs/editor/editor.main.js"></script>
    <script src="js/camus-sql.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="js/download.js"></script>
    <script src="js/storage.js"></script>
</body>

</html>

@code {
    /*
     * This is the only component that can read the launch cookie. HttpContext is cascaded to
     * statically-rendered root components and is gone by the time the interactive circuit starts, so
     * whatever the circuit needs has to be handed to it from here as a parameter.
     *
     * What gets handed over is a single-use handoff, never the session id: parameters to an
     * InteractiveServer component are round-tripped through the page, and a session-lifetime secret
     * has no business going there. The handoff is spent by the circuit within milliseconds and is
     * worthless afterwards. The token itself never appears in either place.
     */

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>
    /// Null unless a vendor launch is in play. ConsoleBranding already defaults to the configured
    /// name, so passing that down here would only make every session look vendor-branded.
    /// </summary>
    private string? _brandName;

    private string? _launchHandoff;

    protected override void OnInitialized()
    {
        if (HttpContext is null || !LaunchOptions.Value.Enabled)
            return;

        bool secure = HttpContext.Request.IsHttps || LaunchOptions.Value.RequireHttps;
        string? sessionId = HttpContext.Request.Cookies[ConsoleLaunchEndpoints.CookieName(secure)];

        if (!LaunchStore.TryGetSession(sessionId, out ConsoleLaunchTicket? ticket) || ticket is null)
            return;

        // Painted into the static render too, so the branded name is on screen before the circuit
        // connects rather than flashing the default first.
        _brandName = ticket.BrandName;

        if (LaunchStore.TryIssueHandoff(sessionId, out string handoff))
            _launchHandoff = handoff;
    }
}
