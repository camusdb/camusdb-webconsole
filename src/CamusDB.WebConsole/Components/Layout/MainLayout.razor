@inherits LayoutComponentBase
@inject CamusSessionService Session
@inject ConsoleBranding Branding
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject ConsoleTheme ConsoleTheme
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="ConsoleTheme.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="console-shell">
    <MudAppBar Elevation="0"
               Dense="true"
               Fixed="false"
               Class="console-appbar"
               Style="background: var(--camus-surface); border-bottom: 1px solid var(--camus-border); position: relative; z-index: 20;">
        @* Plain interpolation, so Blazor HTML-encodes it. Never wrap this in MarkupString, and never
           interpolate it into a Style/class attribute — BrandNameSanitizer is the ingest gate, not a
           licence to put the value into a CSS or JS context. *@
        <MudText Typo="Typo.subtitle1" Class="app-bar-title">@Branding.Name</MudText>
        @if (!string.IsNullOrEmpty(Session.Database))
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="db-chip" Color="Color.Default">
                @Session.Database
            </MudChip>
        }
        <MudSpacer />
        @if (Session.IsAuthenticated)
        {
            <MudTooltip Text="@(Session.UsesSuppliedToken ? "Authenticated with a supplied access token" : $"Authenticated as {Session.User}")">
                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="Color.Success"
                         Icon="@Icons.Material.Filled.Lock"
                         Class="user-chip"
                         OnClose="SignOutAsync"
                         CloseIcon="@Icons.Material.Filled.Logout">
                    @(Session.UsesSuppliedToken ? "token" : Session.User)
                </MudChip>
            </MudTooltip>
        }
        @if (Session.ShowAdministration)
        {
            <MudTooltip Text="Engine stats and variables for the node this console is pointed at">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           Class="admin-btn"
                           StartIcon="@Icons.Material.Filled.MonitorHeart"
                           OnClick="@(() => Navigation.NavigateTo("/admin"))">
                    Administration
                </MudButton>
            </MudTooltip>
        }
        <MudTooltip Text="@(ConsoleTheme.IsDark ? "Switch to the light theme" : "Switch to the dark theme")">
            <MudIconButton Icon="@(ConsoleTheme.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Size="Size.Small"
                           Class="theme-btn"
                           aria-label="Toggle theme"
                           OnClick="ToggleThemeAsync" />
        </MudTooltip>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Small"
                   Class="configure-btn"
                   StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="OpenConfigureAsync">
            Configure
        </MudButton>
    </MudAppBar>

    <div class="console-body">
        @Body
    </div>

    <ConnectionFooter />
</div>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Black = "#0f1113",
            Background = "#1a1c1e",
            Surface = "#212427",
            DrawerBackground = "#212427",
            AppbarBackground = "#212427",
            TextPrimary = "#e8eaed",
            TextSecondary = "#9aa0a6",
            Primary = "#2ecc71",
            Secondary = "#e91e8c",
            Info = "#4ea1ff",
            Success = "#2ecc71",
            Error = "#ef5350",
            Divider = "#3a3f45",
            LinesDefault = "#3a3f45",
        },
        // Same values as the light tokens in console.css.
        PaletteLight = new PaletteLight
        {
            Black = "#1f2328",
            Background = "#f4f5f7",
            Surface = "#ffffff",
            DrawerBackground = "#ffffff",
            AppbarBackground = "#ffffff",
            AppbarText = "#1f2328",
            TextPrimary = "#1f2328",
            TextSecondary = "#5f6670",
            Primary = "#18803f",
            Secondary = "#c2166f",
            Info = "#1764c4",
            Success = "#18803f",
            Error = "#c62828",
            Divider = "#d4d8dd",
            LinesDefault = "#d4d8dd",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["IBM Plex Sans", "Segoe UI", "sans-serif"],
            },
        },
    };

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task OpenConfigureAsync()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
        };

        IDialogReference dialog = await DialogService.ShowAsync<ConfigureDialog>("Configure connection", options);
        await dialog.Result;
    }

    /// <summary>
    /// Revokes the token and drops the connection, then reopens Configure so the console is not left
    /// silently disconnected.
    /// </summary>
    private async Task SignOutAsync()
    {
        await Session.SignOutAsync();
        Snackbar.Add("Signed out.", Severity.Normal);
        await OpenConfigureAsync();
    }

    /// <summary>
    /// Flips the MudBlazor palette here, and the CSS tokens, the editor and the cookie in theme.js.
    /// </summary>
    private async Task ToggleThemeAsync()
    {
        ConsoleTheme.Apply(ConsoleTheme.IsDark ? ConsoleTheme.Light : ConsoleTheme.Dark);

        try
        {
            await JS.InvokeVoidAsync("camusTheme.set", ConsoleTheme.Name);
        }
        catch (JSException)
        {
            // The palette still flips; only the page tokens and the saved choice are missed.
        }
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
