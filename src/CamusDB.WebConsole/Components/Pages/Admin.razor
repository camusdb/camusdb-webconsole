@page "/admin"
@inject CamusSessionService Session
@inject NavigationManager Navigation
@inject ConsoleBranding Branding
@implements IDisposable

<PageTitle>@Branding.PageTitle("Administration")</PageTitle>

<div class="console-main admin-page">
    <div class="admin-header">
        <MudTooltip Text="Back to the query console">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Size="Size.Small"
                           OnClick="@(() => Navigation.NavigateTo("/"))"
                           aria-label="Back to the query console" />
        </MudTooltip>
        <h1 class="admin-title">Administration</h1>
        <span class="admin-subtitle">
            @* The address is named only where the visitor could change it. See ConnectionFooter. *@
            @(Session.EndpointLocked ? "This server" : Session.Endpoint) answers for itself — these
            statements are node-local and never forward to the leader.
        </span>
    </div>

    @if (!Session.IsConnected)
    {
        <div class="empty-state">
            Not connected. Open Configure from the query console and connect first.
        </div>
    }
    else if (Session.AdminAccessProbed && !Session.HasAdminAccess && !Session.HasMonitorAccess)
    {
        <div class="admin-denied">
            <MudAlert Severity="Severity.Warning" Dense="true">
                <MudText Typo="Typo.body2">
                    <b>@(string.IsNullOrEmpty(Session.User) ? "This session" : Session.User)</b> is not a
                    superuser and does not hold MONITOR. With authentication enabled, every surface here except
                    the Node tab requires a superuser. Engine metrics describe Raft topology and whole-node workload, statement
                    statistics hold the SQL text of every user, index usage counts the whole node's
                    workload, the variable list describes the node's whole security posture, and a
                    backup covers every database on the node — none of it is scoped down by a
                    per-database grant, so no grant short of a superuser account opens them.
                </MudText>
                <MudText Typo="Typo.body2" Class="mt-2">
                    The Node tab (disk, CPU and memory of the node) opens with
                    <code>GRANT MONITOR ON *.* TO user</code>. Connect again after the grant.
                </MudText>
            </MudAlert>
        </div>
    }
    else
    {
        <div class="admin-tabbar" role="tablist">
            @foreach (AdminTab tab in VisibleTabs)
            {
                <button type="button"
                        role="tab"
                        class="admin-tab @(CurrentTab == tab ? "active" : null)"
                        aria-selected="@(CurrentTab == tab ? "true" : "false")"
                        @onclick="() => SelectTab(tab)">
                    @Title(tab)
                </button>
            }
        </div>

        @if (MonitorOnly)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="admin-alert">
                This account is not a superuser. It holds the MONITOR privilege, which opens the Node tab
                only.
            </MudAlert>
        }

        @* The node stats call is cheap (the server reads cached values), so the panel stays mounted. *@
        <div class="admin-pane @(CurrentTab == AdminTab.Node ? null : "admin-pane-hidden")">
            <NodeStatsPanel />
        </div>

        @if (!MonitorOnly)
        {
            @* Both panels stay mounted: switching tabs must not throw away the engine-stats baseline. *@
            <div class="admin-pane @(CurrentTab == AdminTab.EngineStats ? null : "admin-pane-hidden")">
                <EngineStatsPanel />
            </div>
            <div class="admin-pane @(CurrentTab == AdminTab.Variables ? null : "admin-pane-hidden")">
                <VariablesPanel />
            </div>
        }
        @* Mounted lazily, like Backups: each one runs a statement when it opens. Once open, they stay
           mounted, so switching tabs keeps their baselines. *@
        @if (_statementsOpened && !MonitorOnly)
        {
            <div class="admin-pane @(CurrentTab == AdminTab.Statements ? null : "admin-pane-hidden")">
                <StatementStatsPanel />
            </div>
        }
        @if (_indexUsageOpened && !MonitorOnly)
        {
            <div class="admin-pane @(CurrentTab == AdminTab.IndexUsage ? null : "admin-pane-hidden")">
                <IndexUsagePanel />
            </div>
        }
        @* Mounted lazily: listing the catalog is a real HTTP call, and it must not fire for someone
           who never opens the tab. *@
        @if (_backupsOpened && !MonitorOnly)
        {
            <div class="admin-pane @(CurrentTab == AdminTab.Backups ? null : "admin-pane-hidden")">
                <BackupsPanel />
            </div>
        }
    }
</div>

@code {
    private enum AdminTab
    {
        Node,
        EngineStats,
        Statements,
        IndexUsage,
        Variables,
        Backups,
    }

    private static readonly AdminTab[] Tabs =
        [AdminTab.Node, AdminTab.EngineStats, AdminTab.Statements, AdminTab.IndexUsage, AdminTab.Variables, AdminTab.Backups];

    private static readonly AdminTab[] MonitorTabs = [AdminTab.Node];

    private AdminTab _tab = AdminTab.Node;

    /// <summary>
    /// True when the session reads the node stats through the MONITOR privilege and is not a
    /// superuser. Every other tab runs a statement that only a superuser may run.
    /// </summary>
    private bool MonitorOnly => Session.AdminAccessProbed && !Session.HasAdminAccess && Session.HasMonitorAccess;

    private AdminTab[] VisibleTabs => MonitorOnly ? MonitorTabs : Tabs;

    /// <summary>The selected tab, or Node when the selected tab is not open to this session.</summary>
    private AdminTab CurrentTab => VisibleTabs.Contains(_tab) ? _tab : AdminTab.Node;
    private bool _statementsOpened;
    private bool _indexUsageOpened;
    private bool _backupsOpened;

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void SelectTab(AdminTab tab)
    {
        _tab = tab;

        if (tab == AdminTab.Statements)
            _statementsOpened = true;
        else if (tab == AdminTab.IndexUsage)
            _indexUsageOpened = true;
        else if (tab == AdminTab.Backups)
            _backupsOpened = true;
    }

    private static string Title(AdminTab tab) => tab switch
    {
        AdminTab.Node => "Node",
        AdminTab.EngineStats => "Engine stats",
        AdminTab.Statements => "Statements",
        AdminTab.IndexUsage => "Index usage",
        AdminTab.Variables => "Variables",
        AdminTab.Backups => "Backups",
        _ => tab.ToString(),
    };

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
